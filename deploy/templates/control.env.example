# Illustrative service configuration. Replace paths and provision secrets separately.
AGENTIC_RUNTIME_CONTROL_DATABASE_URL=
AGENTIC_RUNTIME_ARTIFACT_ROOT=/var/lib/agentic-runtime/artifacts
AGENTIC_RUNTIME_CONTROL_DATABASE_ROLE=agentic_runtime_runtime
AGENTIC_RUNTIME_CONTROL_ADMIN_TOKEN=
AGENTIC_RUNTIME_CONTROL_HOST=127.0.0.1
AGENTIC_RUNTIME_CONTROL_PORT=8765
AGENTIC_RUNTIME_TLS_CERT_FILE=/etc/agentic-runtime/control.crt
AGENTIC_RUNTIME_TLS_KEY_FILE=/etc/agentic-runtime/control.key
AGENTIC_RUNTIME_TLS_CLIENT_CA_FILE=/etc/agentic-runtime/client-ca.crt
AGENTIC_RUNTIME_REQUIRE_TLS=1
