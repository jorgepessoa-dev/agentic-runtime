# Illustrative service configuration. Use per-worker scoped credentials.
AGENTIC_RUNTIME_CONTROL_ENDPOINT=https://control.example.invalid
AGENTIC_RUNTIME_WORKER_ID=worker-example
AGENTIC_RUNTIME_WORKER_TOKEN=
AGENTIC_RUNTIME_WORKER_ROOT=/var/lib/agentic-runtime/worker
AGENTIC_RUNTIME_WORKER_CAPABILITIES=[]
AGENTIC_RUNTIME_WORKER_TASK_TYPES=[]
AGENTIC_RUNTIME_WORKER_RESOURCE_CLASSES=[]
AGENTIC_RUNTIME_WORKER_RESOURCE_POLICY={}
AGENTIC_RUNTIME_TLS_CA_FILE=/etc/agentic-runtime/ca.crt
AGENTIC_RUNTIME_TLS_CERT_FILE=/etc/agentic-runtime/worker.crt
AGENTIC_RUNTIME_TLS_KEY_FILE=/etc/agentic-runtime/worker.key
AGENTIC_RUNTIME_REQUIRE_TLS=1
AGENTIC_RUNTIME_COGNITIVE_CONFIG=/etc/agentic-runtime/cognitive-profiles.json
AGENTIC_RUNTIME_COGNITIVE_ARTIFACT_ROOT=/var/lib/agentic-runtime/cognitive-artifacts
