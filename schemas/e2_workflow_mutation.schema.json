{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E2WorkflowMutation",
  "description": "Declarative bounded mutation of an immutable M9 workflow template. Governance and evaluation controls are external.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation_id",
    "scope_id",
    "parent_genome_id",
    "parent_hash",
    "observation_id",
    "rationale",
    "expected_effect",
    "risk",
    "evaluation_plan_ref",
    "rollback_genome_id",
    "operations"
  ],
  "properties": {
    "mutation_id": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "parent_genome_id": {"type": "string", "minLength": 1},
    "parent_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observation_id": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "expected_effect": {"type": "string", "minLength": 1},
    "risk": {"type": "string", "minLength": 1},
    "evaluation_plan_ref": {"type": "string", "minLength": 1},
    "rollback_genome_id": {"type": "string", "minLength": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "path"],
        "properties": {
          "op": {"enum": ["add", "remove", "replace"]},
          "path": {"type": "string", "pattern": "^/nodes(?:/.*)?$"},
          "value": {}
        },
        "allOf": [
          {"if": {"properties": {"op": {"const": "add"}}, "required": ["op"]}, "then": {"required": ["value"]}},
          {"if": {"properties": {"op": {"const": "replace"}}, "required": ["op"]}, "then": {"required": ["value"]}},
          {"if": {"properties": {"op": {"const": "remove"}}, "required": ["op"]}, "then": {"not": {"required": ["value"]}}}
        ]
      }
    }
  }
}
